# HTTP port the server listens on
PORT=4000

# Secret key used to sign JSON Web Tokens.
# IMPORTANT: Change this to a long, random string in production.
JWT_SECRET=change-me-in-production

# Allowed CORS origin (used in production mode).
# Set to the URL where the frontend is served (same origin when using Docker).
CORS_ORIGIN=http://localhost:4000

# Path to the SQLite database file.
# Override to a persistent volume path when running in Docker.
DB_PATH=./server/queueflow.db
